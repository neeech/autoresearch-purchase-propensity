{
  "data_dir": "data/processed",
  "output_dir": "experiments/lightgbm",
  "max_experiments": 20,
  "budget_minutes": 60,
  "threads": 4,
  "seed": 42,
  "hypothesis": "Muestreo de filas al 80% cada iteraci\u00f3n puede estabilizar \u00e1rboles sin quitar features; activar subsample_freq es necesario para aplicarlo.",
  "params": {
    "n_estimators": 300,
    "learning_rate": 0.025,
    "num_leaves": 31,
    "min_child_samples": 30,
    "reg_lambda": 1,
    "subsample": 0.8,
    "subsample_freq": 1
  }
}
